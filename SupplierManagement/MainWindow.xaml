<Window x:Class="SupplierManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SupplierManagement"
        mc:Ignorable="d"
        WindowState="Maximized"
        Closed="Window_Closed"
        Loaded="Window_Loaded"
        Title="供应商管理系统V1.2" Height="900" Width="1280" Cursor="Hand">
    <Window.Resources>
        <!-- 导航按钮样式 -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,15"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="Center"
                                            Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3E3E42"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 顶部标题栏 -->
            <RowDefinition Height="80"/>
            <!-- 中间内容区域 -->
            <RowDefinition Height="*"/>
            <!-- 底部状态栏 -->
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <Border Grid.Row="0" Background="#2D2D30">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Logo/图片区域 -->
                <Image Grid.Column="0" 
                       Source="/images/logo.png" 
                       Width="60" 
                       Height="60" 
                       Margin="20,0,0,0"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Stretch="Uniform"/>

                <!-- 标题文本 -->
                <TextBlock Grid.Column="1"
                          Text="供应商管理系统"
                          FontSize="24"
                          FontWeight="Bold"
                          Foreground="White"
                          VerticalAlignment="Center"
                          Margin="20,0,0,0"/>
            </Grid>
        </Border>

        <!-- 中间内容区域 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- 左侧导航栏 -->
                <ColumnDefinition Width="200"/>
                <!-- 右侧内容区域 -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧导航栏 -->
            <Border Grid.Column="0" Background="#2D2D30" BorderBrush="#3E3E42" BorderThickness="0,0,1,0">
                <StackPanel Cursor="">
                    <Button x:Name="btnDesign" 
                            Content="🔩 设计管理" 
                            Style="{StaticResource NavButtonStyle}"
                            Visibility="Collapsed"
                            Click="NavigationButton_Click"
                            Tag="Design" Cursor="Hand"/>
                    <Button x:Name="btnBuy" 
                            Content="💡 采购管理" 
                            Style="{StaticResource NavButtonStyle}"
                            Visibility="Collapsed"
                            Click="NavigationButton_Click"
                            Tag="Buyer"/>
                    <Button x:Name="btnQuality" 
                            Content="🎬 质检管理" 
                            Style="{StaticResource NavButtonStyle}"
                            Visibility="Collapsed"
                            Click="NavigationButton_Click"
                            Tag="Quality"/>
                    <Button x:Name="btnInWarehouse" 
                            Content="🎬 入库管理" 
                            Style="{StaticResource NavButtonStyle}"
                            Visibility="Collapsed"
                            Click="NavigationButton_Click"
                            Tag="InWarehouse"/>
                    <Button x:Name="btnOutWarehouse" 
                            Content="🎬 出库管理" 
                            Style="{StaticResource NavButtonStyle}"
                            Visibility="Collapsed"
                            Click="NavigationButton_Click"
                            Tag="OutWarehouse"/>
                    <Button x:Name="btnQuery" 
                       Content="🎬 查询" 
                       Style="{StaticResource NavButtonStyle}"
                            Visibility="Collapsed"
                       Click="NavigationButton_Click"
                       Tag="Query"/>

                    <Button x:Name="btnUser" 
                            Content="👥 用户管理" 
                            Style="{StaticResource NavButtonStyle}"
                            Visibility="Collapsed"
                            Click="NavigationButton_Click"
                            Tag="User"/>
                    <Button x:Name="btnUserRole" 
                            Content="🎬 用户角色管理" 
                            Style="{StaticResource NavButtonStyle}"
                            Visibility="Collapsed"
                            Click="NavigationButton_Click"
                            Tag="UserRole"/>
                    <Button x:Name="btnRolePermission" 
                            Content="🎬 角色权限管理" 
                            Style="{StaticResource NavButtonStyle}"
                            Visibility="Collapsed"
                            Click="NavigationButton_Click"
                            Tag="RolePermission"/>
                    <Button x:Name="btnUpdatePwd" 
                            Content="🎬 修改密码" 
                            Style="{StaticResource NavButtonStyle}"
                            Visibility="Collapsed"
                            Click="NavigationButton_Click"
                            Tag="UpdatePwd"/>



                    <!--<Button x:Name="btnReport" 
                            Content="📈 呼吸灯管理" 
                            Style="{StaticResource NavButtonStyle}"
                            Click="NavigationButton_Click"
                            Tag="Report"/>

                    <Button x:Name="btnSettings" 
                            Content="⚙️ 系统设置" 
                            Style="{StaticResource NavButtonStyle}"
                            Click="NavigationButton_Click"
                            Tag="Settings"/>

                    <Button x:Name="btnAbout" 
                            Content="ℹ️ 关于" 
                            Style="{StaticResource NavButtonStyle}"
                            Click="NavigationButton_Click"
                            Tag="About"/>-->
                </StackPanel>
            </Border>

            <!-- 右侧内容区域 -->
            <Border Grid.Column="1" Background="#1E1E1E">
                <Frame x:Name="contentFrame" 
                       NavigationUIVisibility="Hidden"
                       Background="Transparent">
                    <!-- 默认内容 -->
                    <Frame.Content>
                        <Grid>
                            <TextBlock Text="欢迎使用系统"
                                     FontSize="32"
                                     Foreground="White"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                        </Grid>
                    </Frame.Content>
                </Frame>
            </Border>
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="2" Background="#007ACC" BorderBrush="#3E3E42" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="statusText"
                          Grid.Column="0"
                          Text="就绪"
                          Foreground="White"
                          VerticalAlignment="Center"
                          Margin="10,0"/>

                <TextBlock x:Name="timeText"
                          Grid.Column="1"
                          Text="2024-12-10 14:30:00"
                          Foreground="White"
                          VerticalAlignment="Center"
                          Margin="10,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
