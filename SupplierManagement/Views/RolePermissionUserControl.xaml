<UserControl x:Class="SupplierManagement.Views.RolePermissionUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SupplierManagement.Views"
             mc:Ignorable="d" 
             Background="#1E1E1E" Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resource/Default.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页面标题 -->
        <TextBlock Grid.Row="0"
                   Text="角色权限管理"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="White"
                   Margin="30,20,30,10"/>

        <!-- 页面内容 -->
        <Grid Grid.Row="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Vertical" Grid.Row="0" Grid.Column="0">
                        <TextBlock Grid.Row="0"
                                   Text="角色"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,15"/>
                        <ListBox x:Name="lsRole" Height="500"  Width="320" HorizontalAlignment="Center" Margin="0,0,0,0"
                                 DisplayMemberPath="RoleName"
                                 SelectedValuePath="Id"
                                 SelectionChanged="lsRole_SelectionChanged"
                                 >
                        </ListBox>

                    </StackPanel>

                    <StackPanel Orientation="Vertical" Grid.Row="0" Grid.Column="1">
                        <TextBlock Grid.Row="0"
                                   Text="权限"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,15"/>
                        <ListBox x:Name="lsPermission" SelectionMode="Multiple" Height="500" Width="320" HorizontalAlignment="Center" >
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Content="{Binding MenuName}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Center">
                        <TextBlock Text="角色名称" Style="{StaticResource TextBlockQueryStyle}"/>
                        <TextBox x:Name="txtRoleName" Style="{StaticResource TextBoxStyle}"/>
                        <TextBlock Text="*" Foreground="Red" Style="{StaticResource TextBlockQueryStyle}"/>
                        <Button x:Name="btnAdd" Style="{StaticResource ButtonStyle}" Content="添加角色" Margin="10,0,10,0" Click="btnAdd_Click" />
                        <Button x:Name="btnDele" Style="{StaticResource ButtonStyle}" Content="删除角色"  Margin="10,0,10,0" Click="btnDele_Click" />
                        <Button x:Name="btnSave" Style="{StaticResource ButtonStyle}" Content="保存" Margin="10,0,10,0" Click="btnSave_Click" />
                    </StackPanel>
                </Grid>
            </Border>

       


        </Grid>
    </Grid>
</UserControl>
