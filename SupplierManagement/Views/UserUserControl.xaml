<UserControl x:Class="SupplierManagement.Views.UserUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SupplierManagement.Views"
             mc:Ignorable="d" 
             Background="#1E1E1E">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resource/Default.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页面标题 -->
        <TextBlock Grid.Row="0"
           Text="用户管理"
           FontSize="28"
           FontWeight="Bold"
           Foreground="White"
           Margin="30,20,30,10"/>

        <!-- 页面内容 -->
        <Grid Grid.Row="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="120"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 查询 -->
            <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
           Text="查询"
           FontSize="18"
           FontWeight="Bold"
           Foreground="White"
           Margin="0,0,0,15"/>

                    <StackPanel Orientation="Horizontal" Grid.Row="1">
                        <TextBlock Text="用户ID" Style="{StaticResource TextBlockQueryStyle}"/>
                        <TextBox x:Name="txtUserIDQuery" Style="{StaticResource TextBoxStyle}"/>
                        <TextBlock Text="姓名" Style="{StaticResource TextBlockQueryStyle}"/>
                        <TextBox x:Name="txtUserNameQuery" Style="{StaticResource TextBoxStyle}"/>
                        <Button x:Name="btnQuery" Style="{StaticResource ButtonStyle}" Content="查询" HorizontalAlignment="Right" Click="btnQuery_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 查询结果 -->
            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" >
                <DataGrid x:Name="dg" AutoGenerateColumns="False" CanUserAddRows="False" 
                      HorizontalScrollBarVisibility="Auto" CanUserResizeColumns="True">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn x:Name="chkSelected" Width="30">
                            <DataGridCheckBoxColumn.Header>
                                <CheckBox x:Name="chkAll" Click="chkAll_Click"/>
                            </DataGridCheckBoxColumn.Header>
                        </DataGridCheckBoxColumn>
                        <DataGridTextColumn Header="用户ID" Binding="{Binding UserID}" Width="Auto" />
                        <DataGridTextColumn Header="姓名" Binding="{Binding UserName}" Width="Auto" />
                        <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="Auto" />
                        <DataGridTextColumn Header="创建时间" Binding="{Binding CreateDT, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="Auto" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- 基础信息维护 -->
            <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                       Text="基础信息维护"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,0,0,15"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="用户名" Grid.Row="0" Grid.Column="0" Style="{StaticResource TextBlockQueryStyle}"/>
                                <StackPanel Orientation="Horizontal"  Grid.Row="0" Grid.Column="1">
                                    <TextBox x:Name="txtUserID" Style="{StaticResource TextBoxStyle}"/>
                                    <TextBlock Text="*" Foreground="Red" Style="{StaticResource TextBlockQueryStyle}"/>
                                </StackPanel>
                                <TextBlock Text="姓名" Grid.Row="0" Grid.Column="2" Style="{StaticResource TextBlockQueryStyle}"/>
                                <StackPanel Orientation="Horizontal"  Grid.Row="0" Grid.Column="3">
                                    <TextBox x:Name="txtUserName" Style="{StaticResource TextBoxStyle}"/>
                                    <TextBlock Text="*" Foreground="Red" Style="{StaticResource TextBlockQueryStyle}"/>
                                </StackPanel>
                                <TextBlock Text="密码" Grid.Row="0" Grid.Column="4" Style="{StaticResource TextBlockQueryStyle}"/>
                                <StackPanel Orientation="Horizontal"  Grid.Row="0" Grid.Column="5">
                                    <PasswordBox x:Name="pwd" Margin="10,0,10,0" Width="100" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <TextBlock Text="*" Foreground="Red" Style="{StaticResource TextBlockQueryStyle}"/>
                                </StackPanel>

                                <TextBlock Text="备注" Grid.Row="0" Grid.Column="6" Style="{StaticResource TextBlockQueryStyle}"/>
                                <TextBox x:Name="txtRemark" Grid.Row="0" Grid.Column="7"  Style="{StaticResource TextBoxStyle}"/>
                            </Grid>
                            <StackPanel Grid.Column="1">
                                <Button x:Name="btnAdd" Style="{StaticResource ButtonStyle}" Content="添加" Width="100" Margin="0,0,0,0" Click="btnAdd_Click"/>
                                <Button x:Name="btnDelete" Style="{StaticResource ButtonStyle}"  Content="删除" Width="100"  Margin="0,10,0,0" Click="btnDelete_Click" />
                                <Button x:Name="btnResetPwd" Style="{StaticResource ButtonStyle}"  Content="重置密码" Width="100"  Margin="0,10,0,0" Click="btnResetPwd_Click" />
                            </StackPanel>
                        </Grid>

                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
